@model IEnumerable<BaseViewModel>
<div class="row">
    <table class="table table-hover table-responsive-lg">
        <thead>
            <tr>
                <th>Student</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Value</td>
                </tr>
            }
        </tbody>
    </table>
</div>