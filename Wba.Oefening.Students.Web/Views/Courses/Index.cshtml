@model CoursesIndexViewModel
<h3>@Model.PageTitle</h3>
@* check if courses present *@
@if(Model.Courses.Count() == 0)
{
    <div class="alert alert-danger">
        No courses present
    </div>
}
else
{
    //loop over the courses
    <div class="row">
        @foreach(var course in Model.Courses)
        {
            <div class="col col-3 border border-1 text-center m-2">
                <a asp-controller="Courses"
                   asp-action="Students"
                   asp-route-courseId=@course.Id>@course.Value</a>
                @* <a asp-route="studentsInCourse"
                   asp-route-courseId=@course.Id>@course.Value</a> *@
                <p>
                    <img asp-append-version="true" src="https://placehold.co/200" />
                </p>
            </div>
        }
    </div>
}